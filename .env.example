# Copy this file to .env for local development, and add the same keys in Vercel
# (Project > Settings > Environment Variables).

# Supabase > Project Settings > API
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never prefix with PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile (dash.cloudflare.com > Turnstile). Optional in local dev.
PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key
