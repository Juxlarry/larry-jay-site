---
import data from '../data/portfolio.json';
import { fmtDate } from '../lib/format';
---
<section class="gut" id="credentials">
  <div class="wrap creds">
    <div>
      <h3>Certifications</h3>
      <div class="certs">
        {data.certifications.map((c) => (
          <div class="cert"><b>{c.name}</b><span>{c.issuer}{'date' in c && c.date ? `, ${fmtDate(c.date)}` : ''}</span></div>
        ))}
        {data.inProgress?.map((c) => <div class="cert"><b>{c.name}</b><span>In progress, {c.target}</span></div>)}
      </div>
    </div>
    <div>
      <h3>Education</h3>
      <div class="certs one">
        {data.education.map((e) => <div class="cert"><b>{e.degree}</b>{'major' in e && e.major && <span>Major in {e.major}</span>}</div>)}
      </div>
    </div>
  </div>
</section>
